{
  "name": "dsh-science-workbench",
  "version": "0.2.0",
  "description": "A reproducible science workbench plugin for the DeepSeek Harness: agent-driven cells, inline figures with feedback/rerun, manifest provenance, and environment snapshots.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/index.js",
    "lib/client.js",
    "skills",
    "docs",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "bioinformatics",
    "reproducible-research",
    "workbench",
    "jupyter",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poplarity/dsh-science-workbench.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node --check lib/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
